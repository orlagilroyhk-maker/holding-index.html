# Copy this file to ".env" and edit the values.
# On a host like Render you set these as environment variables in the dashboard
# instead of committing a .env file.

# --- Admin ---------------------------------------------------------------
# Password for the /admin area. CHANGE THIS to something long and private.
ADMIN_PASSWORD=change-me-please
# Username for the /admin area (optional, defaults to "admin").
ADMIN_USER=admin

# --- Server --------------------------------------------------------------
# Port the server listens on (optional, defaults to 3000).
PORT=3000

# --- Database ------------------------------------------------------------
# Leave BOTH of these blank for local development: the app will use a local
# SQLite file (data/responses.db). To change the local file location, set DB_PATH.
DB_PATH=./data/responses.db

# In production, point these at a free Turso cloud database so your data is
# never lost when the host restarts. Get them from `turso db show` and
# `turso db tokens create` (see the README "Deploy it" section).
# DATABASE_URL=libsql://your-db-name-you.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
