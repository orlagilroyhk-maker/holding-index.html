# Copy this file to ".env" and edit the values.
# On most hosts you set these as environment variables in the dashboard instead.

# Password for the /admin area. CHANGE THIS to something long and private.
ADMIN_PASSWORD=change-me-please

# Username for the /admin area (optional, defaults to "admin").
ADMIN_USER=admin

# Port the server listens on (optional, defaults to 3000).
PORT=3000

# Where the SQLite database file lives (optional).
DB_PATH=./data/responses.db
